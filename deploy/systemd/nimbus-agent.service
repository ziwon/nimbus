[Unit]
Description=Nimbus fleet agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nimbus/nimbus.env
ExecStart=/usr/local/bin/nimbus agent run --config /etc/nimbus/agent.yaml
Restart=on-failure
RestartSec=5s
StateDirectory=nimbus
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
